# Quiet Steps reads configuration from the process environment.  This file is
# intentionally not auto-loaded; explicitly source a local ignored .env file
# before starting the API if you choose to use one.  Never add real credentials
# to this example or commit backend/.env.

# Optional. If omitted, the API uses backend/data/quiet_steps.sqlite3.
# QUIET_STEPS_DB_PATH=./data/quiet_steps.sqlite3

# Routine tests and local work use the deterministic bounded mock.
QUIET_STEPS_CHECKIN_MODE=mock

# Comma-separated development origins permitted to call the local API.
QUIET_STEPS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional fictional live-demo configuration. Leave commented unless using a
# fictional, non-sensitive demonstration endpoint; these are not credentials.
# QUIET_STEPS_LIVE_MODEL_URL=https://demo-model.example/v1/checkin
# QUIET_STEPS_LIVE_MODEL_TOKEN=YOUR_FICTIONAL_DEMO_TOKEN
# QUIET_STEPS_LIVE_MODEL_TIMEOUT_SECONDS=4

# Saved-context RAG chatbot. Routine tests use the deterministic mock and make
# no provider request. Set this to openai only for fictional test messages.
QUIET_STEPS_RAG_MODE=mock

# OpenAI Responses API configuration. Place a real key only in the ignored
# backend/.env file; never place it in Vue/VITE variables or commit it.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# QUIET_STEPS_OPENAI_MODEL=gpt-4o-mini
# QUIET_STEPS_OPENAI_TIMEOUT_SECONDS=10

# Live audio session configuration. The API key above remains server-only.
# Voice session creation remains disabled unless this is exactly 1, true, or yes.
# Keep it disabled while working through the mocked backend-only increments.
# VOICE_LIVE_AUDIO_ENABLED=1
VOICE_LIVE_MODEL=gpt-live-1
VOICE_BACKEND_MODEL=gpt-6-luna
VOICE_MAX_SESSION_SECONDS=300
# Minimum 16; maximum 300. The default is 160.
# VOICE_BACKEND_MAX_OUTPUT_TOKENS=160
# VOICE_PROVIDER_TIMEOUT_SECONDS=10
